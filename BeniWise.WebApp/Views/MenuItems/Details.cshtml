@model BeniWise.DataModel.MenuItem
@{
    ViewData["Title"] = Model.Name;
    Layout = "_AdminLayout";
    var ingredients = (Model.Ingredients ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    var allergens = (Model.Allergens ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
}

<a asp-action="Index" class="text-decoration-none">&larr; Back to Menu</a>

<div class="row mt-3">
    <div class="col-md-5">
        <img src="@(Model.ImagePath ?? "/images/placeholder.png")" class="img-fluid rounded shadow-sm" />
    </div>
    <div class="col-md-7">
        <h3 class="fw-bold">@Model.Name</h3>
        <p class="text-muted">@Model.Description</p>

        <h6 class="fw-bold mt-3">Ingredients</h6>
        <ul>
            @foreach (var ing in ingredients)
            {
                <li>@ing</li>
            }
        </ul>

        @if (allergens.Length > 0)
        {
            <div class="alert alert-warning d-inline-block">
                <strong>⚠ Allergens</strong><br />
                Contains: @string.Join(", ", allergens)
            </div>
        }

        <h6 class="fw-bold mt-3">Nutritional Information <small class="text-muted">(per serving)</small></h6>
        <table class="table table-sm w-auto">
            <tr><td>Calories</td><td>@Model.Calories kcal</td></tr>
            <tr><td>Price</td><td>₱@Model.Price.ToString("0.00")</td></tr>
            <tr><td>Category</td><td>@Model.Category?.Name</td></tr>
        </table>
    </div>
</div>
