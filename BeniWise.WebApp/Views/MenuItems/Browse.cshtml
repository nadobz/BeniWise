@model List<BeniWise.DataModel.MenuItem>
@{
    ViewData["Title"] = "Menu";
    Layout = "_UserLayout";
}

<div class="mb-3">
    <h4 class="fw-bold">Menu</h4>
</div>

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body">
        <form method="get" class="row g-2">
            <div class="col-md-6">
                <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search menu item..." />
            </div>
            <div class="col-md-4">
                <select name="categoryId" class="form-select" onchange="this.form.submit()">
                    <option value="">All Categories</option>
                    @foreach (var c in (List<BeniWise.DataModel.Category>)ViewBag.Categories)
                    {
                        <option value="@c.Id" selected="@(ViewBag.SelectedCategoryId == c.Id)">@c.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button class="btn btn-outline-success w-100" type="submit">Search</button>
            </div>
        </form>
    </div>
</div>

<div class="row g-3">
    @foreach (var item in Model)
    {
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <img src="@(item.ImagePath ?? "/images/placeholder.png")"
                     class="card-img-top" style="height:160px; object-fit:cover;" />
                <div class="card-body">
                    <h6 class="fw-bold mb-1">
                        <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none text-dark">@item.Name</a>
                    </h6>
                    <p class="text-muted small mb-1">@item.Category?.Name</p>
                    <p class="fw-semibold mb-0">₱@item.Price.ToString("0.00")</p>
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <p class="text-muted">No menu items match your search yet.</p>
}
