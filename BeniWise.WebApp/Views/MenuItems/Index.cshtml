@model List<BeniWise.DataModel.MenuItem>

@{
    ViewData["Title"] = "Menu Management";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-3">

    <h4 class="fw-bold">
        Menu Management
    </h4>

    <a asp-action="Create"
           class="btn btn-success">

        <i class="bi bi-plus-lg"></i>
        Add New Menu Item

    </a>

</div>

<div class="card border-0 shadow-sm mb-3">

    <div class="card-body">

        <form method="get" class="row g-2">

            <div class="col-md-6">

                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       class="form-control"
                       placeholder="Search menu item..." />

            </div>

            <div class="col-md-4">

                <select name="categoryId"
                        class="form-select"
                        onchange="this.form.submit()">

                    <option value="">
                        All Categories
                    </option>

                    @foreach (var c in (List<BeniWise.DataModel.Category>)ViewBag.Categories)
                    {
                        <option value="@c.Id"
                                selected="@(ViewBag.SelectedCategoryId == c.Id)">
                            @c.Name
                        </option>
                    }

                </select>

            </div>

            <div class="col-md-2">

                <button class="btn btn-outline-success w-100"
                        type="submit">

                    Search

                </button>

            </div>

        </form>

    </div>

</div>

<div class="card border-0 shadow-sm">

    <div class="card-body">

        <table class="table align-middle">

            <thead>

                <tr>
                    <th></th>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Actions</th>
                </tr>

            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <!-- IMAGE -->
                        <td style="width:60px;">

                            <img src="@(item.ImagePath ?? "/images/placeholder.png")"
                                 class="rounded"
                                 width="48"
                                 height="48"
                                 style="object-fit:cover;" />

                        </td>

                        <!-- NAME -->
                        <td>

                            <a asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="menu-item-link">

                                @item.Name

                            </a>

                        </td>

                        <!-- CATEGORY -->
                        <td>
                            @item.Category?.Name
                        </td>

                        <!-- PRICE -->
                        <td>
                            ₱@item.Price.ToString("0.00")
                        </td>

                        <!-- ACTIONS -->
                        <td>

                            <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-success">

                                Edit

                            </a>

                            <form asp-action="Delete"
                                  asp-route-id="@item.Id"
                                  method="post"
                                  class="d-inline delete-menu-form">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-sm btn-danger">

                                    Delete

                                </button>

                            </form>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

@section Scripts {

    <script>

        document.querySelectorAll(".delete-menu-form").forEach(function (form) {

            form.addEventListener("submit", function (event) {

                event.preventDefault();

                Swal.fire({
                    title: "Delete menu item?",
                    text: "This menu item will be permanently deleted.",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonText: "Yes, Delete",
                    cancelButtonText: "Cancel",
                    reverseButtons: true
                }).then((result) => {

                    if (result.isConfirmed) {

                        form.submit();

                    }

                });

            });

        });

    </script>

}