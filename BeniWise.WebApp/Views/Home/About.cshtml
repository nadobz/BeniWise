@{
    ViewData["Title"] = "About";
    Layout = "_UserLayout";
}

<h4 class="fw-bold mb-3">About BeniWise</h4>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <p>
            BeniWise is a digital food information system built for Kitchen City at DLS-CSB.
            It helps students, faculty, and staff make informed choices about what they eat by
            showing menu items alongside their ingredients, allergens, and nutritional information
            before ordering.
        </p>
        <p class="mb-0 text-muted small">
            Know what's in every bite.
        </p>
    </div>
</div>
