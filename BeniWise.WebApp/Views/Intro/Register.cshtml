@{
    ViewData["Title"] = "Register - BeniWise";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
            body {
                background-color: #f5f8f6;
                font-family: 'Segoe UI', sans-serif;
            }

            .intro-container {
                display: flex;
                justify-content: center;
                align-items: center;
                min-height: 100vh;
                padding: 20px;
            }

            .intro-box {
                display: flex;
                width: 900px;
                max-width: 100%;
                background: #fff;
                border-radius: 24px;
                overflow: hidden;
                box-shadow: 0 20px 50px rgba(29, 67, 52, 0.12);
                border: 1px solid #e4eee8;
            }

            .left-panel {
                flex: 1;
                background: linear-gradient(135deg, #45d69a, #25b879);
                color: #fff;
                padding: 50px;
                display: flex;
                flex-direction: column;
                justify-content: center;
                align-items: center;
                text-align: center;
            }

                .left-panel h2 {
                    font-size: 2rem;
                    font-weight: 800;
                }

                .left-panel p {
                    line-height: 1.6;
                }

            .right-panel {
                flex: 1;
                padding: 50px;
            }

                .right-panel h2 {
                    color: #182a23;
                }

            .form-control {
                min-height: 48px;
                border-radius: 12px;
                border: 1px solid #e4eee8;
                background: #fbfdfc;
                padding: 12px 15px;
            }

                .form-control:focus {
                    border-color: #25b879;
                    box-shadow: 0 0 0 3px rgba(69, 214, 154, 0.15);
                }

            .btn-green {
                background-color: #25b879;
                color: #fff;
                border: none;
                min-height: 48px;
                border-radius: 12px;
                font-weight: 650;
            }

                .btn-green:hover {
                    background-color: #1fa86d;
                    color: #fff;
                }

            .btn-light {
                border-radius: 11px;
                font-weight: 600;
            }

            .form-check-input {
                border-color: #d8e5de;
            }

                .form-check-input:checked {
                    background-color: #25b879;
                    border-color: #25b879;
                }

            @@media (max-width: 768px) {
                .intro-box {
                    flex-direction: column;
                }

                .left-panel,
                .right-panel {
                    padding: 35px 25px;
                }
            }
    </style>
</head>

<body>

    <div class="intro-container">

        <div class="intro-box">

            <!-- LEFT SIDE -->
            <div class="left-panel">

                <h2 class="fw-bold mb-3">
                    Welcome to BeniWise!
                </h2>

                <p class="mb-4">
                    Your smarter way to explore the menu and manage your orders.
                </p>

                <p class="mb-2">
                    Already have an account?
                </p>

                <a href="/Intro/Index"
                       class="btn btn-light px-4">
                    Log in
                </a>

            </div>

            <!-- RIGHT SIDE -->
            <div class="right-panel">

                <h2 class="fw-bold mb-4">
                    Create Your Account
                </h2>

                <form asp-controller="Intro"
                      asp-action="Register"
                      method="post">

                    <div class="mb-3">
                        <input type="email"
                               name="email"
                               class="form-control"
                               placeholder="Email"
                               required />
                    </div>

                    <div class="mb-3">
                        <input type="password"
                               name="password"
                               class="form-control"
                               placeholder="Password"
                               required />
                    </div>

                    <div class="mb-3">
                        <input type="text"
                               name="fullName"
                               class="form-control"
                               placeholder="Full Name"
                               required />
                    </div>

                    <button type="submit"
                            class="btn btn-green w-100 mb-3">
                        Sign Up
                    </button>

                </form>

                <div asp-validation-summary="All"
                     class="text-danger">
                </div>

            </div>

        </div>

    </div>

</body>
</html>