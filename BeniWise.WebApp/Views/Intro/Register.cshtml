@{
    ViewData["Title"] = "Register - BeniWise";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            background-color: #f0f0f0;
            font-family: 'Segoe UI', sans-serif;
        }
        .intro-container {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }
        .intro-box {
            display: flex;
            width: 900px;
            background: #fff;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
        }
        .left-panel {
            flex: 1;
            background: linear-gradient(135deg, #009e60, #00c97a);
            color: #fff;
            padding: 50px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }
        .right-panel {
            flex: 1;
            padding: 50px;
        }
        .btn-green {
            background-color: #009e60;
            color: #fff;
            border: none;
        }
        .btn-green:hover {
            background-color: #007b4a;
        }
    </style>
</head>
<body>
    <div class="intro-container">
        <div class="intro-box">
            <!-- Left side: Welcome -->
            <div class="left-panel text-center">
                <h2 class="fw-bold mb-3">Join BeniWise</h2>
                <p class="mb-4">Create your account and start exploring smart meal management.</p>
                <p>Already registered?</p>
                <a href="/Intro/Index" class="btn btn-light px-4">Log in</a>
            </div>

            <!-- Right side: Register form -->
            <div class="right-panel">
                <h2 class="fw-bold mb-4">Create Account</h2>
                <form asp-controller="Intro" asp-action="Register" method="post">
                    <div class="mb-3">
                        <input type="email" name="email" class="form-control" placeholder="Email" required />
                    </div>
                    <div class="mb-3">
                        <input type="password" name="password" class="form-control" placeholder="Password" required />
                    </div>
                    <div class="mb-3">
                        <input type="text" name="fullName" class="form-control" placeholder="Full Name" required />
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="termsCheck" required />
                        <label class="form-check-label" for="termsCheck">
                            I accept the terms of the agreement
                        </label>
                    </div>
                    <button type="submit" class="btn btn-green w-100 mb-3">Sign up</button>
                </form>

                <div asp-validation-summary="All" class="text-danger"></div>
            </div>
        </div>
    </div>
</body>
</html>
