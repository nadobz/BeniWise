@{
    ViewData["Title"] = "Welcome to BeniWise";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            background-color: #f0f0f0;
            font-family: 'Segoe UI', sans-serif;
        }
        .intro-container {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }
        .intro-box {
            display: flex;
            width: 900px;
            background: #fff;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
        }
        .left-panel {
            flex: 1;
            padding: 50px;
        }
        .right-panel {
            flex: 1;
            background: linear-gradient(135deg, #009e60, #00c97a);
            color: #fff;
            padding: 50px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }
        .btn-green {
            background-color: #009e60;
            color: #fff;
            border: none;
        }
        .btn-green:hover {
            background-color: #007b4a;
        }
    </style>
</head>
<body>
    <div class="intro-container">
        <div class="intro-box">
            <!-- Left side: Login -->
            <div class="left-panel">
                <h2 class="fw-bold mb-4">Sign in</h2>
                <form asp-controller="Intro" asp-action="Login" method="post">
                    <div class="mb-3">
                        <input type="text" name="email" class="form-control" placeholder="Username or Email" required />
                    </div>
                    <div class="mb-3">
                        <input type="password" name="password" class="form-control" placeholder="Password" required />
                    </div>
                    <button type="submit" class="btn btn-green w-100 mb-3">Sign in</button>
                </form>
                <div asp-validation-summary="All" class="text-danger"></div>
                <p class="text-center text-muted">
                    No account? <a href="/Intro/Register" class="text-success fw-semibold">Register here</a>
                </p>
            </div>

            <!-- Right side: Welcome -->
            <div class="right-panel text-center">
                <h2 class="fw-bold mb-3">Welcome back!</h2>
                <p class="mb-4">We’re happy to have you here again. Enjoy exploring your smart meal companion — <strong>BeniWise</strong>.</p>
                <!-- Removed the Go to Dashboard button -->
            </div>
        </div>
    </div>
</body>
</html>
