@using BeniWise.DataModel
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - BeniWise</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="~/css/dashboard.css"
          asp-append-version="true" />
</head>

<body>

    <div class="dashboard-shell">

        <aside class="user-sidebar">

            <div class="brand">
                <i class="bi bi-egg-fried"></i>
                <span>BeniWise</span>
            </div>

            @{
                var currentController =
                    ViewContext.RouteData.Values["controller"]?.ToString();

                var currentAction =
                    ViewContext.RouteData.Values["action"]?.ToString();
            }

            <ul class="nav flex-column mt-4">

                <!-- DASHBOARD -->
                <li class="nav-item">
                    <a class="nav-link @(currentController == "Home" && currentAction == "Index" ? "active" : "")"
                           asp-controller="Home"
                           asp-action="Index">

                        <i class="bi bi-house-door"></i>
                        Dashboard

                    </a>
                </li>

                <!-- MENU -->
                <li class="nav-item">
                    <a class="nav-link @(currentController == "MenuItems" ? "active" : "")"
                           asp-controller="MenuItems"
                           asp-action="Browse">

                        <i class="bi bi-egg-fried"></i>
                        Menu

                    </a>
                </li>

                <!-- CART -->
                <li class="nav-item">

                    @if (User.IsInRole("Admin") || User.IsInRole("CafeteriaStaff"))
                    {
                        <a href="#"
                               class="nav-link"
                               id="restrictedCartButton">

                            <i class="bi bi-cart3"></i>
                            Cart

                        </a>
                    }
                    else
                    {
                        <a class="nav-link @(currentController == "Cart" ? "active" : "")"
                               asp-controller="Cart"
                               asp-action="Index">

                            <i class="bi bi-cart3"></i>
                            Cart

                        </a>
                    }

                </li>

                <!-- MY ORDERS -->
                <li class="nav-item">

                    @if (User.IsInRole("Admin") || User.IsInRole("CafeteriaStaff"))
                    {
                        <a href="#"
                               class="nav-link"
                               id="restrictedOrdersButton">

                            <i class="bi bi-receipt"></i>
                            My Orders

                        </a>
                    }
                    else
                    {
                        <a class="nav-link @(currentController == "Orders" && currentAction == "Index" ? "active" : "")"
                               asp-controller="Orders"
                               asp-action="Index">

                            <i class="bi bi-receipt"></i>
                            My Orders

                        </a>
                    }

                </li>

            </ul>

            <!-- LOGOUT -->
            <div class="mt-auto">

                <form asp-controller="Intro"
                      asp-action="Logout"
                      method="post"
                      id="logoutForm">

                    @Html.AntiForgeryToken()

                    <button type="button"
                            class="nav-link border-0 bg-transparent text-start w-100"
                            id="logoutButton">

                        <i class="bi bi-box-arrow-right"></i>
                        Logout

                    </button>

                </form>

            </div>

        </aside>

        <main class="user-content">

            <div class="d-flex justify-content-end align-items-center mb-3">

                @{
                    var currentUser = await UserManager.GetUserAsync(User);
                    var displayName = currentUser?.Firstname ?? "Guest";
                }

                <span class="me-2">
                    Hello, @displayName!
                </span>

                <div class="avatar-circle">
                    <i class="bi bi-person-fill"></i>
                </div>

            </div>

            @RenderBody()

        </main>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Logout Confirmation -->
    <script>

        document.getElementById("logoutButton")?.addEventListener("click", function () {

        Swal.fire({
        title: "Are you sure?",
        text: "You will be logged out of your account.",
        icon: "warning",
        showCancelButton: true,
        confirmButtonText: "Yes, Logout",
        cancelButtonText: "Cancel",
        reverseButtons: true
        }).then((result) => {

        if (result.isConfirmed) {

        document.getElementById("logoutForm").submit();

        }

        });

        });

        // Restricted Cart
        document.getElementById("restrictedCartButton")?.addEventListener("click", function (event) {

        event.preventDefault();

        Swal.fire({
        title: "Customer Access Only",
        text: "The cart is only available for student/customer accounts.",
        icon: "info",
        confirmButtonText: "OK"
        });

        });

        // Restricted My Orders
        document.getElementById("restrictedOrdersButton")?.addEventListener("click", function (event) {

        event.preventDefault();

        Swal.fire({
        title: "Customer Access Only",
        text: "My Orders is only available for student/customer accounts.",
        icon: "info",
        confirmButtonText: "OK"
        });

        });

    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>