@model BeniWise.WebApp.Models.CreateStaffViewModel
@{
    ViewData["Title"] = "Add Staff Account";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="fw-bold">Add Staff Account</h4>
    <a asp-action="Staff" class="btn btn-outline-secondary">Back to Staff List</a>
</div>

<div class="card border-0 shadow-sm" style="max-width:500px;">
    <div class="card-body">
        <form asp-action="CreateStaff" method="post">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label class="form-label">First Name</label>
                <input asp-for="Firstname" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Last Name</label>
                <input asp-for="Lastname" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Email</label>
                <input asp-for="Email" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Temporary Password</label>
                <input asp-for="Password" class="form-control" type="password" />
            </div>

            <button type="submit" class="btn btn-success">Create Staff Account</button>
        </form>
    </div>
</div>
