@model BeniWise.DataModel.Order

@{
    ViewData["Title"] = "Order Confirmation";
    Layout = "_UserLayout";
}

<div class="card border-0 shadow-sm">
    <div class="card-body text-center p-5">

        <div class="mb-3">
            <i class="bi bi-check-circle-fill text-success"
               style="font-size: 60px;"></i>
        </div>

        <h3 class="fw-bold">Order Placed Successfully!</h3>

        <p class="text-muted">
            Thank you for your order. Your order has been received.
        </p>

        <hr />

        <div class="text-start mx-auto" style="max-width: 500px;">

            <p class="mb-2">
                <strong>Order ID:</strong>
                #@Model.Id
            </p>

            <p class="mb-2">
                <strong>Order Date:</strong>
                @Model.OrderDate.ToString("MMMM dd, yyyy hh:mm tt")
            </p>

            <p class="mb-2">
                <strong>Status:</strong>
                <span class="badge bg-warning text-dark">
                    @Model.Status
                </span>
            </p>

        </div>

        <hr />

        <h5 class="fw-bold mb-3">Order Summary</h5>

        <div class="table-responsive">
            <table class="table align-middle">

                <thead>
                    <tr>
                        <th>Item</th>
                        <th>Quantity</th>
                        <th>Price</th>
                        <th>Subtotal</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model.OrderItems)
                    {
                        var subtotal = item.Price * item.Quantity;

                        <tr>
                            <td>
                                @item.MenuItem?.Name
                            </td>

                            <td>
                                @item.Quantity
                            </td>

                            <td>
                                ₱@item.Price.ToString("0.00")
                            </td>

                            <td>
                                ₱@subtotal.ToString("0.00")
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>

        <div class="d-flex justify-content-end mt-3">
            <h5 class="fw-bold">
                Total: ₱@Model.TotalAmount.ToString("0.00")
            </h5>
        </div>

        <div class="d-flex justify-content-center gap-2 mt-4">

            <a asp-controller="Orders"
                   asp-action="Index"
                   class="btn btn-outline-success">
                <i class="bi bi-receipt me-1"></i>
                View My Orders
            </a>

            <a asp-controller="MenuItems"
                   asp-action="Browse"
                   class="btn btn-success">
                <i class="bi bi-shop me-1"></i>
                Continue Shopping
            </a>

        </div>

    </div>
</div>