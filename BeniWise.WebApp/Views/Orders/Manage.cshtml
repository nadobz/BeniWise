@model List<BeniWise.DataModel.Order>

@{
    ViewData["Title"] = "Order Management";
    Layout = "_AdminLayout";
}

@if (Model == null || !Model.Any())
{
    <div class="text-center p-5">

        <i class="bi bi-receipt text-muted"
           style="font-size: 50px;"></i>

        <h5 class="fw-bold mt-3">
            No orders yet
        </h5>

        <p class="text-muted">
            Customer orders will appear here.
        </p>

    </div>
}
else
{
    <div class="table-responsive">

        <table class="table align-middle">

            <thead>
                <tr>
                    <th>Order</th>
                    <th>Customer</th>
                    <th>Date</th>
                    <th>Items</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var order in Model)
                {
                    <tr>

                        <!-- ORDER -->
                        <td>
                            <strong>#@order.Id</strong>
                        </td>

                        <!-- CUSTOMER -->
                        <td>
                            <strong>
                                @order.User?.Firstname @order.User?.Lastname
                            </strong>

                            <br />

                            <small class="text-muted">
                                @order.User?.Email
                            </small>
                        </td>

                        <!-- DATE -->
                        <td>
                            @order.OrderDate.ToString("MMM dd, yyyy")
                            <br />

                            <small class="text-muted">
                                @order.OrderDate.ToString("hh:mm tt")
                            </small>
                        </td>

                        <!-- ITEMS -->
                        <td>
                            @order.OrderItems.Count item(s)
                        </td>

                        <!-- TOTAL -->
                        <td>
                            <strong>
                                ₱@order.TotalAmount.ToString("0.00")
                            </strong>
                        </td>

                        <!-- STATUS -->
                        <td>

                            @if (order.Status == BeniWise.DataModel.OrderStatus.Pending)
                            {
                                <!-- PENDING → PREPARING -->
                                <form asp-controller="Orders"
                                      asp-action="UpdateStatus"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@order.Id" />

                                    <select name="status"
                                            class="form-select form-select-sm"
                                            onchange="this.form.submit()">

                                        <option value="Pending" selected>
                                            Pending
                                        </option>

                                        <option value="Preparing">
                                            Preparing
                                        </option>

                                    </select>

                                </form>
                            }
                            else if (order.Status == BeniWise.DataModel.OrderStatus.Preparing)
                            {
                                <!-- PREPARING → READY FOR PICKUP -->
                                <form asp-controller="Orders"
                                      asp-action="UpdateStatus"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@order.Id" />

                                    <select name="status"
                                            class="form-select form-select-sm"
                                            onchange="this.form.submit()">

                                        <option value="Preparing" selected>
                                            Preparing
                                        </option>

                                        <option value="ReadyForPickup">
                                            Ready for Pickup
                                        </option>

                                    </select>

                                </form>
                            }
                            else if (order.Status == BeniWise.DataModel.OrderStatus.ReadyForPickup)
                            {
                                <!-- WAITING FOR CUSTOMER -->
                                <span class="badge bg-primary">
                                    Ready for Pickup
                                </span>

                                <br />

                                <small class="text-muted">
                                    Waiting for customer pickup
                                </small>
                            }
                            else if (order.Status == BeniWise.DataModel.OrderStatus.Completed)
                            {
                                <!-- COMPLETED BY CUSTOMER -->
                                <span class="badge bg-success">
                                    Completed
                                </span>

                                <br />

                                <small class="text-muted">
                                    Pickup confirmed
                                </small>
                            }

                        </td>

                        <!-- ACTION -->
                        <td>

                            <a asp-controller="Orders"
                                   asp-action="ManageDetails"
                                   asp-route-id="@order.Id"
                                   class="btn btn-sm btn-outline-success">
                                View
                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>
}